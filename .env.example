# AgentForge — environment variables
#
# Copy to .env and fill in. NEVER commit .env.
# CONTRACT.md -> "Environment variables" is the authoritative reference; keep the two in sync.
# Production values are set on the Cloud Run service, not in a file. See DEPLOYMENT.md.
#
# Generate any secret with:  openssl rand -base64 32

# ─────────────────────────────────────────────────────────────────────────────
# Database — Neon Postgres. TWO strings, and they are not interchangeable.
# ─────────────────────────────────────────────────────────────────────────────

# POOLED endpoint (host contains "-pooler"). Used by the application at runtime.
# Cloud Run runs several instances, each with its own pool; Neon's free compute has a low
# connection limit. Using the direct endpoint here causes intermittent "too many connections".
DATABASE_URL=

# DIRECT endpoint (no "-pooler"). Used ONLY for migrations, which need a session-level
# connection that the pooler breaks.
DATABASE_URL_UNPOOLED=

# ─────────────────────────────────────────────────────────────────────────────
# Auth — Google OAuth
# ─────────────────────────────────────────────────────────────────────────────

# Session/JWT signing secret. 32+ random bytes. Use a DIFFERENT value per environment.
AUTH_SECRET=

# Canonical app origin used to build OAuth callbacks.
# Must match the deployed origin EXACTLY, no trailing slash — a mismatch fails in a way that
# looks like a bad client id.
#   local:      http://localhost:3000
#   production: the Cloud Run service URL
AUTH_URL=http://localhost:3000

# From the Google Cloud OAuth client. See DEPLOYMENT.md -> One-time setup step 4.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Encryption — for third-party credentials and user LLM keys at rest
# ─────────────────────────────────────────────────────────────────────────────

# AES-256-GCM key: exactly 32 bytes, base64-encoded. REQUIRED.
#
# Two jobs since Phase 21, and both still need it:
#   1. It is the ROOT KEY when ROOT_KEY_SECRET below is unset — which is how a developer
#      machine and CI work with no cloud at all.
#   2. It decrypts any credential still in the Chapter 1 single-layer shape, whatever
#      ROOT_KEY_SECRET says.
#
# The Chapter 1 warning is no longer the whole story: changing this makes unreadable only the
# rows it is still the key for. Run `scripts/rekey.mjs --dry-run` first to see which those are,
# and SECURITY.md -> "Rotating the root key" for the procedure.
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Root key — OPTIONAL (Phase 21). Secret Manager, for a rotatable root key.
# ─────────────────────────────────────────────────────────────────────────────

# The Secret Manager secret holding the root key that wraps every credential's own data key.
#
# LEAVE THIS EMPTY LOCALLY. Unset means ENCRYPTION_KEY is the root key, version `env`, which
# needs no cloud and is the right local behaviour. Set, it means versions: adding one is a
# rotation, and `scripts/rekey.mjs` moves the database onto it without decrypting a secret.
#
# On the deployed service it is `agentforge-root-key`. The settings -> Vault tab reports which
# of the two this deployment is using, because a deployment silently on the environment key
# has the Chapter 1 problem back without the Chapter 1 warning.
ROOT_KEY_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL, used to build the webhook URLs shown to users.
APP_BASE_URL=http://localhost:3000

# Shared secret for the MACHINE ENDPOINTS: POST /api/cron/tick and POST /api/runs/dispatch.
# Cloud Scheduler sends it for the tick; Cloud Tasks sends it in the task's headers for a
# dispatch. Both routes reject anything without it.
#
# One secret for both is deliberate (Phase 17): the dispatch route's real authorisation is
# the run's own 192-bit dispatchToken, so this is the outer gate rather than the thing that
# grants anything. Without it, anyone could fire every scheduled workflow on demand.
CRON_SECRET=

# development | production
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# LLM — optional
# ─────────────────────────────────────────────────────────────────────────────

# Server-side Gemini key, for local development and the demo account only.
# The product's real path is each user pasting their own key in-app, stored encrypted.
# This is not a substitute for that feature.
GOOGLE_GENERATIVE_AI_API_KEY=

# Demo Discord webhook, created in Phase 0 (M6) for #agentforge-demo.
# Development and demo convenience ONLY. The product's real path is the user pasting a webhook
# URL into the Discord node, stored encrypted like any other integration credential.
# Anyone holding this URL can post to that channel — treat it as a secret.
DISCORD_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Phase 23B integrations — SCRIPT-ONLY, and never set on the service
# ─────────────────────────────────────────────────────────────────────────────
#
# These exist for one reason: `scripts/verify-integrations.mjs` proves Slack, Notion,
# GitHub and Airtable against the REAL services from the deployed app, and it needs
# credentials to do it. The product itself never reads them — a user's credentials live
# encrypted in the `credentials` table, connected through Settings → Integrations.
#
# Setting any of these on Cloud Run would put a long-lived third-party token in a place
# that survives restarts, for no benefit. Same rule as GCP_ACCESS_TOKEN (Phase 21).
#
# A service whose variables are absent is SKIPPED by the script and counted as skipped —
# never as passed.

# Slack: an incoming webhook. https://api.slack.com/apps → Incoming Webhooks.
SLACK_WEBHOOK_URL=

# Notion: an internal integration secret, plus one page and one database that have been
# connected to it in Notion itself ("…" → Connections). Ids are the 32-hex chunk in the URL.
NOTION_TOKEN=
NOTION_PAGE_ID=
NOTION_DATABASE_ID=

# GitHub: a fine-grained token with Issues = read and write, on ONE repository you do not
# mind test issues in. The verification files a real issue and leaves it open.
GITHUB_TOKEN=
GITHUB_REPO=

# Airtable: a personal access token with data.records:read and data.records:write, granted
# the base below. The table needs at least one existing row, so the script can learn a real
# column name rather than guessing one.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=

# ─────────────────────────────────────────────────────────────────────────────
# Durable execution — optional (Phase 17)
# ─────────────────────────────────────────────────────────────────────────────

# The Cloud Tasks queue that carries durable runs.
#
# LEAVE THIS EMPTY LOCALLY. There is no metadata server on a developer machine and no queue
# in CI, so a durable run falls back to executing in-process — still leased, still
# checkpointed, still resumable, just not redeliverable. That is the right local behaviour.
#
# On the deployed service it is `agentforge-runs`. Unset there, durable runs quietly stop
# surviving a redeploy with nothing to say so, which is why GET /api/health reports
# `queue.configured` and the deployed verification asserts it.
TASKS_QUEUE=

# The queue's region. Falls back to GCP_REGION, which is almost always right.
TASKS_LOCATION=

# The queue's project. Falls back to the metadata server, which cannot be wrong in the way a
# copied variable can. Set only if the queue lives outside this project.
TASKS_PROJECT=

# ─────────────────────────────────────────────────────────────────────────────
# Deploy-time only — NOT read by the application
# ─────────────────────────────────────────────────────────────────────────────

GCP_PROJECT_ID=
GCP_REGION=asia-southeast1
CLOUD_RUN_SERVICE=agentforge

# ─────────────────────────────────────────────────────────────────────────────
# Script-only — NEVER set these on the Cloud Run service
# ─────────────────────────────────────────────────────────────────────────────

# `scripts/rekey.mjs` needs a Google access token and a project to reach Secret Manager from a
# machine with no metadata server. Supply them on the command line rather than in this file:
#
#   GCP_PROJECT=<project> GCP_ACCESS_TOKEN="$(gcloud auth print-access-token)" \
#     node --env-file=.env --import ./scripts/test-register.mjs scripts/rekey.mjs --dry-run
#
# On Cloud Run the token comes from the metadata server, which is short-lived by construction.
# An access token pasted into a service environment variable is a long-lived credential in a
# place that survives restarts.
#
#   GCP_ACCESS_TOKEN
#   GCP_PROJECT
