{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic workflow automation — describe what you want, get a real executable workflow",
  "license": "MIT",
  "author": "Arunish Rajput",
  "homepage": "https://github.com/arunishrajput/AgentForge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunishrajput/AgentForge.git"
  },
  "bugs": {
    "url": "https://github.com/arunishrajput/AgentForge/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/test-register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.ts'",
    "test:coverage": "node --import ./scripts/test-register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-coverage --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='src/lib/engine/fixtures.ts' --test-coverage-lines=85 --test-coverage-branches=88 --test-coverage-functions=76 --test 'src/**/*.test.ts'",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:scripts && npm run docs:check",
    "docs:build": "node --import ./scripts/test-register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-docs.mjs",
    "docs:check": "node --import ./scripts/test-register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-docs.mjs --check",
    "probe:models": "node scripts/probe-models.mjs",
    "design:export": "node --import ./scripts/test-register.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-illustrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@neondatabase/serverless": "1.1.0",
    "@xyflow/react": "12.12.0",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
